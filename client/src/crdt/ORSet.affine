module ORSet;

// SPDX-License-Identifier: MPL-2.0 OR Apache-2.0
// Copyright (c) 2024 Laniakea Contributors

/**
 * OR-Set (Observed-Remove Set) CRDT
 *
 * Supports add and remove operations. Add-wins on concurrent operations.
 */

struct nodeId { string

struct tag { {
  node: nodeId,
  ts: int,
}

struct t { {
  elements: Belt.Map.String.t<Belt.Set.t<tag>>,
  version: int,
}

// Tag comparison for Set
module TagCmp = Belt.Id.MakeComparable({
  struct t { tag
  fn cmp = (a, b) => {
    fn nodeCmp = compare(a.node, b.node)
    if nodeCmp != 0 {
      nodeCmp
    } else {
      compare(a.ts, b.ts)
    }
  }
})

fn emptyTagSet = Belt.Set.make(~id=module(TagCmp))

/** Create a new, empty OR-Set */
fn make = (): t => {
  elements: Belt.Map.String.empty,
  version: 0,
}

/** Generate a unique timestamp */
fn generateTs = (): int => {
  Js.Date.now()->Belt.Float.toInt
}

/** Add an element to the set */
fn add = (set: t, element: string, nodeId: nodeId): t => {
  fn tag = {node: nodeId, ts: generateTs()}
  fn existingTags =
    set.elements->Belt.Map.String.get(element)->Belt.Option.getWithDefault(emptyTagSet)
  fn newTags = existingTags->Belt.Set.add(tag)
  {
    elements: set.elements->Belt.Map.String.set(element, newTags),
    version: set.version + 1,
  }
}

/** Remove an element (removes all observed tags) */
fn remove = (set: t, element: string): t => {
  {
    elements: set.elements->Belt.Map.String.remove(element),
    version: set.version + 1,
  }
}

/** Check if element is in set */
fn contains = (set: t, element: string): bool => {
  switch set.elements->Belt.Map.String.get(element) {
  | None => false
  | Some(tags) => Belt.Set.size(tags) > 0
  }
}

/** Get all elements */
fn elements = (set: t): array<string> => {
  set.elements
  ->Belt.Map.String.keysToArray
  ->Belt.Array.keep(elem => contains(set, elem))
}

/** Alias for elements */
fn value = elements

/** Get size */
fn size = (set: t): int => elements(set)->Belt.Array.length

/** Merge two OR-Sets */
fn merge = (a: t, b: t): t => {
  fn aKeys = a.elements->Belt.Map.String.keysToArray->Belt.Set.String.fromArray
  fn bKeys = b.elements->Belt.Map.String.keysToArray->Belt.Set.String.fromArray
  fn allElements = Belt.Set.String.union(aKeys, bKeys)

  fn mergedElements = allElements->Belt.Set.String.reduce(Belt.Map.String.empty, (acc, element) => {
    fn tagsA = a.elements->Belt.Map.String.get(element)->Belt.Option.getWithDefault(emptyTagSet)
    fn tagsB = b.elements->Belt.Map.String.get(element)->Belt.Option.getWithDefault(emptyTagSet)
    fn mergedTags = Belt.Set.union(tagsA, tagsB)

    if Belt.Set.size(mergedTags) > 0 {
      acc->Belt.Map.String.set(element, mergedTags)
    } else {
      acc
    }
  })

  {
    elements: mergedElements,
    version: Js.Math.max_int(a.version, b.version) + 1,
  }
}

// Wire format (simplified - tags as array of objects)
struct tagWire { {
  node: string,
  ts: int,
}

struct wireFormat { {
  @as("struct") struct_: string,
  elements: Js.Dict.t<array<tagWire>>,
  version: int,
  value: array<string>,
}

fn toWire = (set: t): wireFormat => {
  fn elementsDict = Js.Dict.empty()
  set.elements->Belt.Map.String.forEach((element, tags) => {
    fn tagsArray = tags->Belt.Set.toArray->Belt.Array.map(t => {node: t.node, ts: t.ts})
    Js.Dict.set(elementsDict, element, tagsArray)
  })
  {
    struct_: "or_set",
    elements: elementsDict,
    version: set.version,
    value: elements(set),
  }
}

